# ==============================================================================
# FINORA AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi `.env` untuk pengembangan lokal.
# JANGAN PERNAH menyimpan secret key atau AI API key di variabel berawalan VITE_!
# ==============================================================================

# 1. PUBLIC CLIENT CONFIGURATION (Aman untuk Browser — Wajib dilindungi RLS)
VITE_APP_NAME="Finora AI"
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# 2. SERVER-SIDE ONLY CONFIGURATION (Hanya untuk /api/ai/* Serverless/Edge)
# Jangan pernah memberi prefix VITE_ pada variabel di bawah ini!
AI_PROVIDER_NAME="openrouter"
AI_PROVIDER_BASE_URL="https://openrouter.ai/api/v1"
AI_PROVIDER_API_KEY=""
AI_MODEL_NAME=""
AI_REQUEST_TIMEOUT_MS="25000"

